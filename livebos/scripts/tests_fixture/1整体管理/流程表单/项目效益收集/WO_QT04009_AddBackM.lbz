<?xml version="1.0" encoding="gb2312"?>
<process xmlns="http://www.livebos.com/bizlogic/process" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attribute="0" exitOnStandardFault="false" isHorizontalLayout="false" method="WO_QT04009_AddBackM" name="WO_QT04009_AddBackM" object="WO_QT04009" type="0" xsi:schemaLocation="http://www.livebos.com/bizlogic/process http://www.livebos.com/bizlogic_process.xsd">
  <describe>项目效益收集申请单-新增项目月效益明细流程</describe>
  <variables>
    <variable describe="V_1" instanceType="WO_QT04009_FFeeMBen" messageType="" name="V_1" type="objectSet" />
    <variable describe="V_2" instanceType="WO_QT04009_FFeeMBen" messageType="" name="V_2" type="object" />
  </variables>
  <sequence id="0" name="顺序">
    <assign id="0">
      <describe>赋值</describe>
      <copy>
        <from type="expression">O_MASTER.FFeeMBen</from>
        <to variable="V_1" />
      </copy>
    </assign>
    <forEach collection="V_1" id="0" toVariable="V_2">
      <describe>迭代</describe>
      <sequence id="0" name="顺序">
        <invoke component="FormSetOperate" id="0" name="批量对象组件_修改" operation="update">
          <describe>批量修改对象[项目效益台账]</describe>
          <arg name="@objectName">T_PJBenefit</arg>
          <arg name="@condition">["FProject={0}",[{"expression":"V_2.FProject","length":"","scale":"","type":"1"}]]</arg>
          <arg flag="field" name="FTMoney" type="expression">V_2.FTMoney</arg>
        </invoke>
        <invoke component="SQL" id="0" name="数据库组件_执行SQL语句" operation="execute">
          <describe>commit</describe>
          <arg name="TranType">sql</arg>
          <arg name="SQL">["commit",[]]</arg>
        </invoke>
        <invoke component="CallBizProcess" id="0" name="对象流程组件">
          <describe>对象流程-【项目月效益明细-新增流程】</describe>
          <arg name="processName">T_BenfitM_Add</arg>
          <arg flag="parameter" name="FProject" type="expression">V_2.FProject</arg>
          <arg flag="parameter" name="FName" type="expression">V_2.FName</arg>
          <arg flag="parameter" name="FProNo" type="expression">V_2.FProject.FProNo</arg>
          <arg flag="parameter" name="FUnits" type="expression">V_2.FUnits</arg>
          <arg flag="parameter" name="FDate" type="expression">V_2.FYM</arg>
          <arg flag="parameter" name="FMoneyM" type="expression">V_2.FBackM</arg>
          <arg flag="parameter" name="FMoneyTM" type="expression">V_2.FTBackM</arg>
          <arg flag="parameter" name="FMonthCut" type="expression">V_2.FTBackM-V_2.FBackM</arg>
        </invoke>
      </sequence>
    </forEach>
  </sequence>
</process>

