<?xml version="1.0" encoding="gb2312"?>
<process xmlns="http://www.livebos.com/bizlogic/process" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attribute="0" exitOnStandardFault="false" isHorizontalLayout="false" name="WO_QT04009_UILOGIC" object="WO_QT04009" type="1" xsi:schemaLocation="http://www.livebos.com/bizlogic/process http://www.livebos.com/bizlogic_process.xsd">
  <describe>一人多岗</describe>
  <variables />
  <sequence id="0" name="顺序">
    <invoke component="FormUI" id="0" name="界面处理_刷新字段可选项" operation="resetOption">
      <describe>界面处理_刷新字段可选项</describe>
      <arg flag="field" name="FAppPost" type="">true</arg>
      <arg flag="field" name="FOrg" type="">false</arg>
    </invoke>
    <invoke component="FormUI" id="0" name="界面处理_更新值" operation="setValue">
      <describe>界面处理_更新值</describe>
      <arg flag="field" name="FAppPost" type="expression">var post = null;&#xD;
if(O_MASTER.FUser.FiscomplexPost==0){&#xD;
	post = ABS_SQLVALUE("select a.fpost from T_HR_EmployeePost a where a.fuserid = ?",[O_MASTER.FUser]);&#xD;
}&#xD;
post;</arg>
    </invoke>
    <invoke component="FormUI" id="0" name="界面处理_重计算表达式" operation="evalExpression">
      <describe>界面处理_重计算表达式</describe>
      <arg flag="field" name="FOrg" type="">true</arg>
      <arg flag="field" name="FFullName" type="">true</arg>
    </invoke>
    <if id="0">
      <describe>判断申请人是否多岗</describe>
      <conditions>
        <condition name="" type="expression">
          <arg name="expression">&lt;%@ livebos language='javascript' %&gt;
O_MASTER.FUser.FiscomplexPost == 1</arg>
        </condition>
      </conditions>
      <sequence id="0" name="顺序">
        <invoke component="FormUI" id="0" name="界面处理_更改字段空值属性" operation="changeNullable">
          <describe>界面处理_更改字段空值属性</describe>
          <arg flag="field" name="FAppPost" type="">false</arg>
        </invoke>
        <invoke component="FormUI" id="0" name="界面处理_更改输入状态" operation="changeState">
          <describe>界面处理_更改输入状态</describe>
          <arg flag="field" name="FAppPost" type="">true</arg>
        </invoke>
      </sequence>
      <else>
        <describe>Else</describe>
        <sequence id="0" name="顺序">
          <invoke component="FormUI" id="0" name="界面处理_更改字段空值属性" operation="changeNullable">
            <describe>界面处理_更改字段空值属性</describe>
            <arg flag="field" name="FAppPost" type="">true</arg>
          </invoke>
          <invoke component="FormUI" id="0" name="界面处理_更改输入状态" operation="changeState">
            <describe>界面处理_更改输入状态</describe>
            <arg flag="field" name="FAppPost" type="">4</arg>
          </invoke>
        </sequence>
      </else>
    </if>
  </sequence>
</process>

