<?xml version="1.0" encoding="gb2312"?>
<process xmlns="http://www.livebos.com/bizlogic/process" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attribute="0" exitOnStandardFault="false" isHorizontalLayout="false" method="PM_ImportTest_M" name="PM_ImportTest_M" object="PM_ImportTest" type="0" xsi:schemaLocation="http://www.livebos.com/bizlogic/process http://www.livebos.com/bizlogic_process.xsd">
  <describe>项目月效益回收明细更新-批量修改数据流程</describe>
  <variables>
    <variable describe="V_1" messageType="" name="V_1" type="resultSet" />
    <variable describe="V_2" instanceType="PM_ImportTest" messageType="" name="V_2" type="object" />
    <variable describe="V_3" messageType="" name="V_3" type="string" />
  </variables>
  <sequence id="0" name="顺序">
    <invoke component="SQL" id="0" name="数据库组件_SQL查询" operation="query">
      <describe>数据库组件_SQL查询</describe>
      <arg name="TranType">sql</arg>
      <arg name="SQL">["select * from PM_ImportTest ",[]]</arg>
      <arg name="@retResultSet" type="output">V_1</arg>
    </invoke>
    <forEach collection="V_1" id="0" toVariable="V_2">
      <describe>迭代</describe>
      <sequence id="0" name="顺序">
        <invoke component="SQL" id="0" name="数据库组件_执行SQL语句" operation="execute">
          <describe>数据库组件_执行SQL语句</describe>
          <arg name="TranType">sql</arg>
          <arg name="SQL">["update WO_QT04009_FFeeMBen set FSubstandard={0},FImprove={1} where  FProject={2} and FYM=to_char({3})",[{"expression":"V_2.FSubstandard","length":"","scale":"","type":"0"},{"expression":"V_2.FImprove","length":"","scale":"","type":"0"},{"expression":"V_2.FProject","length":"","scale":"","type":"1"},{"expression":"V_2.FYM","length":"","scale":"","type":"1"}]]</arg>
          <arg name="@autoExit" type="expression">false</arg>
          <arg name="@retValue" type="output">V_3</arg>
        </invoke>
      </sequence>
    </forEach>
  </sequence>
</process>

